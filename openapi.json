ault": 0}, "at_best_pct": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "At Best Pct", "description": "최우선 레벨에서 난 비율 %"}, "n_imb": {"type": "integer", "title": "N Imb", "description": "불균형을 잰 체결 — 문면에 종목이 있는 것(csrc=stated)만", "default": 0}, "n_imb_prev": {"type": "integer", "title": "N Imb Prev", "description": "불균형은 있으나 맨 ㅎㅈ 를 직전 호가에 붙인 것(csrc=prev) — 연구가 못 잰 모집단이라 뺀 수", "default": 0}, "p_b_by_imb": {"additionalProperties": {"$ref": "#/components/schemas/ImbCell"}, "type": "object", "title": "P B By Imb", "description": "직전 불균형 구간(오퍼 우세·균형·비드 우세)별 사 감 비율", "default": {}}}, "type": "object", "title": "BookInfo", "description": "책이 말하는 것 — 오늘 귀속 체결에서 잰 셋(국고·통안). 값은 엔진이 체결 순간에 재 둔 것.\n국고 전 이력 실측은 RESULT_book_dynamics_2026-09-15.md."}, "ClsPill": {"properties": {"cls": {"type": "string", "title": "Cls"}, "n": {"type": "integer", "title": "N", "description": "살아 있는 건수(계열) 또는 칸이 서는 종목 수(국고·통안)", "default": 0}, "gov": {"type": "boolean", "title": "Gov", "description": "계열이 아니라 레인이다 — 등급 대신 만기 버킷으로 접힌다", "default": false}}, "type": "object", "required": ["cls"], "title": "ClsPill", "description": "분류 줄의 한 칸. 순서가 곧 «구성» 이다 — 국고·통안 다음 위험순 계열 여덟.\n[OWNER 2026-09-11] 히트맵 행과 같은 축으로 세웠다."}, "CreditBucket": {"properties": {"k": {"type": "string", "title": "K"}, "cls": {"type": "string", "title": "Cls"}, "rt": {"type": "string", "title": "Rt"}, "est": {"type": "boolean", "title": "Est", "description": "등급이 문면이 아니라 집계에서 온 것", "default": false}, "gov": {"type": "boolean", "title": "Gov", "description": "국고·통안 버킷 — n 의 단위가 «건» 이 아니라 «종» 이다", "default": false}, "stale": {"type": "boolean", "title": "Stale", "description": "그 칸에 «민평이 그날 것이 아닌» 종목이 있다(통안 최신물)", "default": false}, "n": {"type": "integer", "title": "N"}, "nat": {"type": "integer", "title": "Nat", "description": "그중 «민평에» 오퍼 수 — 중앙값에서는 뺀다 [OWNER 2026-09-07]", "default": 0}, "mb": {"type": "integer", "title": "Mb", "default": 0}, "bp_med": {"anyOf": [{"type": "number"}, {"type": "null"}], "title": "Bp Med"}, "b